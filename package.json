{
  "name": "loop",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "backend": "bun run --filter @loop/backend dev",
    "seed": "bun run --filter @loop/backend seed",
    "web": "bun run --filter @loop/web dev",
    "mobile": "bun run --filter @loop/mobile start",
    "ios": "bun run --filter @loop/mobile ios",
    "android": "bun run --filter @loop/mobile android"
  }
}
